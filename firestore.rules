rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // [교사 권한 판별 함수]
    // 선생님의 실제 UID가 등록되어 교사 권한을 확인합니다.
    function isTeacher() {
      return request.auth != null && request.auth.uid in [
        "xfq1agGlssSdIyyOr5FeRJWBd6T2" // 선생님(교사)의 실제 UID
      ];
    }

    match /memos/{memoId} {
      // 1. 누구나 담벼락을 읽을 수 있습니다.
      allow read: if true;

      // 2. 글 작성 (생성):
      // - 교사: 모든 글 작성 허용
      // - 학생: 5글자 이상이며 본인의 uid로만 작성 허용
      allow create: if request.auth != null && (
        isTeacher() || (
          request.resource.data.text is string 
          && request.resource.data.text.size() >= 5
          && request.resource.data.uid == request.auth.uid
        )
      );

      // 3. 글 삭제:
      // - 오직 교사(선생님)만 모든 글 삭제 가능 (학생은 삭제 불가)
      allow delete: if request.auth != null && isTeacher();
    }
  }
}
